{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexi Lang offline model pack",
  "description": "A complete immutable pack installed as one user action on Mac/iPhone/iPad.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "license", "notice", "assets"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}$"},
    "license": {"type": "string", "minLength": 2},
    "notice": {"type": "string", "minLength": 3},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "downloadURL", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}$"},
          "downloadURL": {"type": "string", "format": "uri", "pattern": "^https://github[.]com/NatNeuralPivot/lexilang-offline-models/releases/download/"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
